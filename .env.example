# ── C.I.D — Code Intelligent Debugger ───────────────────────────────────────
# Copy this file to .env and add your real API key
# Get a free Groq key from: https://console.groq.com
#
#   PowerShell:  copy .env.example .env
#
# NEVER commit your real .env (it is already in .gitignore).

# ── Required ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_paste_your_key_here

# ── Security ────────────────────────────────────────────────────────────────
# Used to sign login session cookies — use a long random string.
FLASK_SECRET_KEY=generate-a-long-random-string-here
FLASK_ENV=development

# ── App identity (optional — these are the defaults if left out) ───────────
APP_NAME=C.I.D
APP_FULL_NAME=Code Intelligent Debugger
APP_VERSION=1.0.0
APP_AUTHOR=Your Name Here
MAX_CODE_LENGTH=50000
RATE_LIMIT_PER_MINUTE=10
DEFAULT_LLM_PROVIDER=groq